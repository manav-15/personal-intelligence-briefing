{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-intelligence-briefing",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "ai": { "binding": "AI", "remote": true },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "PERSONAL_BRIEFING", "class_name": "PersonalBriefingAgent" },
      { "name": "SEARXNG", "class_name": "SearxngContainer" },
    ],
  },
  "containers": [
    {
      "name": "searxng",
      "class_name": "SearxngContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "default": {
          "dockerfile": "./infra/searxng/Dockerfile",
          "build_context": "./infra/searxng",
        },
      },
    },
  ],
  "exports": {
    "PersonalBriefingAgent": { "type": "durable-object", "storage": "sqlite" },
    "SearxngContainer": {
      "type": "durable-object",
      "storage": "sqlite",
      "container": "searxng",
    },
  },
}
