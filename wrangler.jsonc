{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-intelligence-briefing",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // Access verifies every request. ACCESS_AUD is added once the Access
  // application exists; until then the Worker refuses all requests.
  "vars": { "ACCESS_TEAM_DOMAIN": "briefing-agent.cloudflareaccess.com" },
  "ai": { "binding": "AI", "remote": true },
  "workflows": [
    {
      "name": "briefing-workflow",
      "binding": "BRIEFING_WORKFLOW",
      "class_name": "BriefingWorkflow",
    },
  ],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/agents", "/agents/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "PERSONAL_BRIEFING", "class_name": "PersonalBriefingAgent" },
    ],
  },
  "exports": {
    "PersonalBriefingAgent": { "type": "durable-object", "storage": "sqlite" },
  },
}
