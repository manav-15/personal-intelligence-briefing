{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-intelligence-briefing",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  // The app is served from the free workers.dev address; preview URLs stay off
  // so there is no second, easily-forgotten surface to protect.
  "workers_dev": true,
  "preview_urls": false,
  // Access verifies every request: the team domain supplies the signing keys and
  // ACCESS_AUD pins the one application whose tokens are accepted.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "briefing-agent.cloudflareaccess.com",
    "ACCESS_AUD": "e55b9f5ad794088a501d7cc3c87dea053e21b60d615fcfdb31f57cc7e32f608f",
  },
  "ai": { "binding": "AI", "remote": true },
  "workflows": [
    {
      "name": "briefing-workflow",
      "binding": "BRIEFING_WORKFLOW",
      "class_name": "BriefingWorkflow",
    },
  ],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/agents", "/agents/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "PERSONAL_BRIEFING", "class_name": "PersonalBriefingAgent" },
    ],
  },
  "exports": {
    "PersonalBriefingAgent": { "type": "durable-object", "storage": "sqlite" },
  },
}
