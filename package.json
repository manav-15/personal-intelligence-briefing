{
  "name": "personal-intelligence-briefing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --fix --max-warnings 0",
    "typecheck": "tsc -p tsconfig.web.json && tsc -p tsconfig.server.json && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:google-links": "node scripts/verify-google-news-link.mjs",
    "verify:search-links": "node scripts/verify-search-sources.mjs",
    "searxng:start": "node scripts/start-searxng.mjs",
    "searxng:stop": "docker compose -f infra/searxng/compose.yml down",
    "verify:searxng-evidence": "node scripts/verify-searxng-evidence.mjs",
    "evaluate:briefing-run": "node scripts/evaluate-briefing-run.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.110",
    "@cloudflare/ai-chat": "0.12.0",
    "@cloudflare/containers": "0.3.7",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "agents": "0.24.0",
    "ai": "7.0.107",
    "hono": "4.13.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.10",
    "@cloudflare/workers-types": "5.20260916.1",
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "prettier": "3.9.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "wrangler": "4.133.0"
  }
}
